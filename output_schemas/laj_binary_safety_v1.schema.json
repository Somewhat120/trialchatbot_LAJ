{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LAJ Safety Binary Output v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["reasoning", "final_score"],
    "properties": {
      "reasoning": {
        "type": "string",
        "minLength": 1,
        "description": "Brief justification referencing the decision logic."
      },
      "final_score": {
        "type": "integer",
        "enum": [0, 1],
        "description": "0 = no violation, 1 = violation present."
      }
    }
  }
  